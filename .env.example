NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
TRUST_PROXY_HOPS=1
SESSION_SECRET=replace_with_a_random_secret_at_least_32_bytes
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=class_sphere
PGUSER=class_sphere_app
PGPASSWORD=replace_me
# Add Aiven's CA certificate contents here for verified TLS.
DATABASE_SSL_CA=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Private uploads need durable object storage or a paid Render persistent disk.
PRIVATE_STORAGE_DIR=./private-storage

OPENAI_API_KEY=
OPENAI_MODEL=
